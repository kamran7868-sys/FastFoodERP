{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/index.html"
    },
    {
      "source": "/pages/:page",
      "destination": "/pages/:page.html"
    },
    {
      "source": "/:page",
      "destination": "/pages/:page.html"
    }
  ]
}
